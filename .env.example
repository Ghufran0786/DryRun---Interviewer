# App mode: local (SQLite + disk snapshots, default) | hosted (Postgres + Supabase Storage)
APP_MODE=local

# SQLite (local): path relative to prisma/schema.prisma → ./data/dryrun.db at project root
DATABASE_URL=file:../data/dryrun.db

# Hosted Postgres (Supabase): pooled + direct URLs for Prisma migrate
# DATABASE_URL=postgresql://...
# DIRECT_URL=postgresql://...

# Deepgram — server-side only. Member scope or higher (token grant + optional proxy fallback).
DEEPGRAM_API_KEY=

# STT transport: direct (default, browser bearer JWT) | proxy (legacy local ws://localhost:3001)
DEEPGRAM_TRANSPORT=direct

# OpenRouter — server-side only (classifier, interviewer, TTS, optional evaluator).
OPENROUTER_API_KEY=

# Hosted snapshots + auth (anon key server-only; service role is server-only)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SNAPSHOT_BUCKET=snapshots
# DRYRUN_OWNER_USER_ID=<uuid from scripts/discover-supabase-owner.mjs>
# OWNER_EMAIL=<owner login email for debug-page gate in hosted mode>

# Next.js runtime mode; usually set automatically by `next dev` / `next start`.
NODE_ENV=

# Optional / dev-only — Google Stitch MCP in Cursor; not read by the DryRun app.
STITCH_API_KEY=
