# SQLite database URL (path is relative to prisma/schema.prisma → ./data/dryrun.db at project root; not a secret)
DATABASE_URL=file:../data/dryrun.db

# Deepgram API key — server-side only (proxy + token diagnostic). Member scope or higher.
DEEPGRAM_API_KEY=

# OpenRouter API key — server-side only (classifier, interviewer, TTS, optional evaluator).
OPENROUTER_API_KEY=

# Next.js runtime mode; usually set automatically by `next dev` / `next start` (development | production | test).
NODE_ENV=

# Optional / dev-only — Google Stitch MCP in Cursor; not read by the DryRun app.
STITCH_API_KEY=
