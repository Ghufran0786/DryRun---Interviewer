# SQLite database (relative to project root)
# Path is relative to prisma/schema.prisma → resolves to ./data/dryrun.db at project root
DATABASE_URL="file:../data/dryrun.db"

# Deepgram — server-side only. Create a key at https://console.deepgram.com/
# Member scope or higher required for browser JWT grant (Phase 3).
DEEPGRAM_API_KEY=

# OpenRouter — server-side only. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Stitch MCP (optional) — for @_davideast/stitch-mcp proxy in Cursor MCP settings
STITCH_API_KEY=
